{
  "permissions": {
    "deny": [
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Bash(npx wrangler deploy*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 300,
            "statusMessage": "lint・型チェック・テストを実行中"
          }
        ]
      }
    ]
  }
}
