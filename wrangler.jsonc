{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triptych-slideshow",
  "compatibility_date": "2026-10-01",
  // DNS レコードと証明書はデプロイ時に Wrangler が自動作成する
  "routes": [
    { "pattern": "triptych.komori.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  }
}
